# Plantilla del .env del backend. Copiar a backEnd/.env y completar.
# NUNCA poner valores reales en este archivo (se sube a GitHub).

PORT=3000
CACHE_TTL_MS=600000

# Cuenta de servicio de Firebase (Consola de Google Cloud → IAM → Cuentas de servicio → Claves)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entre comillas dobles y con los saltos de línea como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Orígenes que pueden llamar a la API (separados por coma). Vacío = ninguno externo.
CORS_ORIGIN=http://localhost:4200,https://inago.inacode.cl

# Clave del panel #admin: solo para crear/editar/eliminar edificios. Mínimo 24 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# true solo si hay un proxy de confianza adelante (cPanel/LiteSpeed, Nginx, Docker)
TRUST_PROXY=false

# Límites de solicitudes (opcionales)
# RATE_LIMIT_LECTURA=300   # por minuto y por IP
# RATE_LIMIT_ADMIN=20      # cada 15 minutos y por IP
