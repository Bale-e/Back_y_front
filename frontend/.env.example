# El frontend Angular no lee variables de entorno en tiempo de ejecución.
# La URL de la API se define en src/app/core/config/api.config.ts
# (localhost -> http://127.0.0.1:3000, producción -> https://api.inago.inacode.cl).
#
# Ya NO hay API_TOKEN en el frontend: las lecturas del mapa son públicas y las
# escrituras usan la clave de administrador que se escribe en el panel #admin
# (ADMIN_TOKEN, definido solo en backEnd/.env).
